# No secrets required. Public configuration only (never put keys here).
# Local development default:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Production (Vercel environment variable):
# NEXT_PUBLIC_API_BASE_URL=https://petro-forge.onrender.com
# AI Co-Pilot 3D avatar: optional licensed GLB URL (procedural placeholder is built-in).
# Leave unset unless you host a properly licensed engineer model.
# NEXT_PUBLIC_COPILOT_AVATAR_URL=https://example.com/licensed-engineer.glb
# Server-side only (Render env, NEVER NEXT_PUBLIC_*): COPILOT_LLM_PROVIDER,
# COPILOT_LLM_MODEL, COPILOT_LLM_API_KEY. Unset = labelled fallback templates.
